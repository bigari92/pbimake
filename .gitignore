# Byte-compiled and caches — regenerated, never source
__pycache__/
*.py[cod]
_schema_cache/

# Scratch output from test and build runs
*.tmp
/out/
/scratch/

# Power BI local state — machine-specific, never shared
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Never commit real data OR generated data. tests/generate_data.py is seeded,
# so tests/fixtures/*.csv is reproducible byte-for-byte and does not belong in
# git; tests/fixtures/make_fixture.py regenerates it on demand.
*.csv
*.xlsx
*.pbix
