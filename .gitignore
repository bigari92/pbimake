# Byte-compiled and caches — regenerated, never source
__pycache__/
*.py[cod]
_schema_cache/

# Scratch output from test and build runs
*.tmp
/out/
/scratch/

# Power BI local state — machine-specific, never shared
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Never commit real data. Fixtures are GENERATED by tests/generate_data.py.
*.csv
*.xlsx
*.pbix
!tests/fixtures/*.csv
