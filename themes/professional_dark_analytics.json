{
  "$schema": "https://powerbi.com/product/schema#report",
  "name": "Professional Dark Analytics",
  "dataColors": [
    "#00B4D8",
    "#4CC9F0",
    "#F72585",
    "#7209B7",
    "#3A86FF",
    "#FFBE0B",
    "#06D6A0",
    "#FB5607"
  ],
  "good": "#06D6A0",
  "neutral": "#FFBE0B",
  "bad": "#F72585",
  "maximum": "#00B4D8",
  "center": "#FFBE0B",
  "minimum": "#3A4260",
  "null": "#A0A8BC",
  "background": "#1A2033",
  "foreground": "#F0F0F0",
  "tableAccent": "#00B4D8",
  "firstLevelElements": "#F0F0F0",
  "secondLevelElements": "#A0A8BC",
  "thirdLevelElements": "#3A4260",
  "fourthLevelElements": "#2E3650",
  "secondaryBackground": "#242B3D",
  "textClasses": {
    "callout": {
      "fontSize": 36,
      "fontFace": "Segoe UI Semibold",
      "color": "#F0F0F0"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#F0F0F0"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#F0F0F0"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A0A8BC"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#242B3D"
              }
            },
            "transparency": 0
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0D1117"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 12,
            "angle": 90,
            "shadowDistance": 4,
            "transparency": 60
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "background": {
              "solid": {
                "color": "#242B3D"
              }
            },
            "alignment": "left",
            "bold": false,
            "italic": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#3A4260"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#3A4260"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "lineWidth": 3
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "fontSize": 36,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#F0F0F0"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#F0F0F0"
              }
            }
          }
        ]
      }
    },
    "funnel": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#3A4260"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#3A4260"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "treemap": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "backColor": {
              "solid": {
                "color": "#00B4D8"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "bold": true,
            "outline": "None"
          }
        ],
        "rows": [
          {
            "fontColor": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "backColor": {
              "solid": {
                "color": "#242B3D"
              }
            },
            "alternatingBackColor": {
              "solid": {
                "color": "#2E3650"
              }
            },
            "fontSize": 10,
            "outline": "None"
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#3A4260"
              }
            },
            "gridHorizontalWeight": 1
          }
        ],
        "totals": [
          {
            "fontColor": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "bold": true,
            "backColor": {
              "solid": {
                "color": "#2E3650"
              }
            }
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "backColor": {
              "solid": {
                "color": "#00B4D8"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "rows": [
          {
            "fontColor": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "backColor": {
              "solid": {
                "color": "#242B3D"
              }
            },
            "alternatingBackColor": {
              "solid": {
                "color": "#2E3650"
              }
            },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#3A4260"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#3A4260"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#3A4260"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "textSize": 10,
            "background": {
              "solid": {
                "color": "#242B3D"
              }
            },
            "outline": "None"
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 9
          }
        ],
        "calloutValue": [
          {
            "color": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "labelDisplayUnits": 0
          }
        ],
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#00B4D8"
              }
            }
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#F0F0F0"
              }
            },
            "fontSize": 18
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A0A8BC"
              }
            },
            "fontSize": 10
          }
        ],
        "card": [
          {
            "outline": "None",
            "barShow": true,
            "barColor": {
              "solid": {
                "color": "#00B4D8"
              }
            },
            "barWeight": 2
          }
        ]
      }
    }
  }
}