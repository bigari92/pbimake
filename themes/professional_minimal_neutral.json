{
  "$schema": "https://powerbi.com/product/schema#report",
  "name": "Professional Minimal Neutral",
  "dataColors": [
    "#2D6A4F",
    "#52B788",
    "#95D5B2",
    "#1C4E80",
    "#B5838D",
    "#6B7280",
    "#F4A261",
    "#264653"
  ],
  "good": "#2D6A4F",
  "neutral": "#F4A261",
  "bad": "#C0392B",
  "maximum": "#2D6A4F",
  "center": "#F4A261",
  "minimum": "#E8F5EE",
  "null": "#6B7280",
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#2D6A4F",
  "firstLevelElements": "#1A1A1A",
  "secondLevelElements": "#6B7280",
  "thirdLevelElements": "#E5E7EB",
  "fourthLevelElements": "#D1D5DB",
  "secondaryBackground": "#FAFAFA",
  "textClasses": {
    "callout": {
      "fontSize": 36,
      "fontFace": "Segoe UI Semibold",
      "color": "#1A1A1A"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1A1A1A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1A1A1A"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#1A1A1A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 6
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 8,
            "right": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alignment": "left",
            "bold": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "lineStyles": [
          {
            "lineWidth": 3
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "card": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "fontSize": 36,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "pieChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#1A1A1A"
              }
            }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#1A1A1A"
              }
            }
          }
        ]
      }
    },
    "funnel": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "scatterChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": true,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "treemap": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2D6A4F"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "bold": true,
            "outline": "None"
          }
        ],
        "rows": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alternatingBackColor": {
              "solid": {
                "color": "#FAFAFA"
              }
            },
            "fontSize": 10,
            "outline": "None"
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "gridHorizontalWeight": 1
          }
        ],
        "totals": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "bold": true,
            "backColor": {
              "solid": {
                "color": "#FAFAFA"
              }
            }
          }
        ]
      }
    },
    "matrix": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#2D6A4F"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "rows": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "alternatingBackColor": {
              "solid": {
                "color": "#FAFAFA"
              }
            },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "fontSize": 9,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineClusteredColumnComboChart": {
      "*": {
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            }
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "labels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 9
          }
        ],
        "calloutValue": [
          {
            "color": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "labelDisplayUnits": 0
          }
        ],
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#2D6A4F"
              }
            }
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [
          {
            "color": {
              "solid": {
                "color": "#1A1A1A"
              }
            },
            "fontSize": 18
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10
          }
        ],
        "card": [
          {
            "outline": "None",
            "barShow": true,
            "barColor": {
              "solid": {
                "color": "#2D6A4F"
              }
            },
            "barWeight": 2
          }
        ]
      }
    }
  }
}